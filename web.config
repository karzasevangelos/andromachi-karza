<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration — LOCAL HOSTING ONLY.

  Production is GitHub Pages (no custom headers; the form posts to FormSubmit).
  `_headers` is kept for a Cloudflare Pages / Netlify move. This file re-states
  the security headers and the MIME types for local IIS testing.

  THE SITE MUST BE THE ROOT OF ITS OWN IIS SITE — never an application under
  Default Web Site. Every path in the HTML is absolute (`/css/style.css`,
  `/en/`, `/fonts/…`), so under `/Andromachi` they resolve to wwwroot and the
  page loads with no CSS, no JS and no fonts.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- remove-then-add: adding an extension the parent already maps throws
         500.19 "cannot add duplicate collection entry". -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
    </staticContent>

    <!-- Mirrors `_headers`. Same CSP as production, so a policy violation
         shows up here rather than after deploy. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
